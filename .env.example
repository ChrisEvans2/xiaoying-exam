DATABASE_URL=postgresql://xiaoying:xiaoying@localhost:55432/xiaoying
DATA_DIR=.runtime/files
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Both query expansion and agent decisions use thinking mode; completion tokens include reasoning.
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=16384
# Business profile stays live. Offline demos use ./start.sh --mock and .env.mock.example.
PROVIDER_MODE=live
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
# Immutable revisions from the official BAAI repositories; changing embeddings requires rebuilding.
MINERU_COMMAND=["mineru","-p","{input}","-o","{output}","-b","pipeline"]
PDF_BACKEND=mineru
MODEL_TIMEOUT_SECONDS=45
TOOL_TIMEOUT_SECONDS=20
READ_TIMEOUT_SECONDS=5
ACTIVE_TIMEOUT_SECONDS=180
CLARIFICATION_SECONDS=600
QUEUE_TIMEOUT_SECONDS=60
LEASE_SECONDS=60
HEARTBEAT_SECONDS=10
SCAN_SECONDS=5
MAX_MODEL_CALLS=12
MAX_TOOL_CALLS=8
MAX_GRAPH_STEPS=40
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=200
BUILD_TIMEOUT_SECONDS=1800
PDF_TIMEOUT_SECONDS=600
