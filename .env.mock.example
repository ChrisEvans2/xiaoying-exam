# Only ./start.sh --mock, xiaoying --mock and demo_cases.py read this profile.
# Business .env / DATABASE_URL / DATA_DIR are not inherited.
XIAOYING_MOCK_DATABASE_URL=postgresql://xiaoying:xiaoying@localhost:55432/xiaoying_mock
XIAOYING_MOCK_DATA_DIR=.runtime/mock/files
XIAOYING_MOCK_PROVIDER_MODE=mock
XIAOYING_MOCK_PDF_BACKEND=test_text
